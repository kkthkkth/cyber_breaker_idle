<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13(API 33)+에서 로컬 알림을 실제로 띄우려면 런타임에 이
         권한을 요청해야 한다(NotificationManager.init()이 앱 시작 시 한
         번 요청한다) — 매니페스트 선언 자체는 요청을 위한 전제조건일 뿐,
         유저가 거부하면 알림은 조용히 표시되지 않는다(크래시 없음). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:label="idle_rpg"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- google_mobile_ads(AdManager)가 요구하는 필수 메타데이터 —
             값이 없으면 앱이 시작하자마자 크래시한다. 지금 들어있는 값은
             Google이 공개한 "테스트용 App ID"(admob.google.com 문서
             참고)이고, 실제 배포 전 반드시 AdMob 콘솔에서 발급받은 이
             앱만의 실제 App ID로 교체해야 한다 — [AdManager] 문서 참고. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <meta-data
            android:name="com.google.android.gms.ads.AD_MANAGER_APP"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Supabase 구글 로그인(signInWithOAuth) 완료 후 브라우저가
                 이 커스텀 스킴으로 되돌아오면 앱을 다시 띄운다 — scheme/host는
                 SupabaseManager._mobileRedirectTo('cyberbreaker://
                 login-callback')와 반드시 정확히 일치해야 한다. http(s)가
                 아닌 커스텀 스킴이라 App Links 검증(autoVerify)은 해당사항
                 없다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="cyberbreaker" android:host="login-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Supabase 구글 로그인(signInWithOAuth)이 내부적으로 url_launcher로
             https URL(Supabase authorize 엔드포인트)을 연다. Android 11
             (API 30) 이상은 이 <queries> 선언이 없으면, 브라우저가 실제로
             설치돼 있어도 "열 수 있는 앱이 없다"고 판단해 조용히 아무 반응
             없이 실패한다(패키지 가시성 제한) — 구글 로그인 버튼이 "먹통"
             처럼 보이는 문제의 가장 유력한 원인이 이것이다.
             참고: https://pub.dev/packages/url_launcher#android -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
